# Copy this file to .env in the project root and fill in your local values.
# .env is gitignored — never commit real passwords.

POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=EnterpriseLoggerDb

DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=EnterpriseLoggerDb;Username=saas_admin;Password=your_secure_password_here
REDIS_CONNECTION_STRING=localhost:6379

# Log ingestion rate limit (tenant-scoped, POST /api/logs only)
LOG_INGEST_RATE_LIMIT_PER_MINUTE=1000
LOG_INGEST_RATE_LIMIT_WINDOW_SECONDS=60

# Public endpoint rate limits (IP-scoped)
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TENANT_REGISTER_RATE_LIMIT_PER_MINUTE=5
TENANT_REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

# Login lockout & backoff (email + IP counters in Redis)
LOGIN_MAX_FAILED_ATTEMPTS_EMAIL=10
LOGIN_MAX_FAILED_ATTEMPTS_IP=30
LOGIN_LOCKOUT_MINUTES=15
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_BACKOFF_START_AFTER=3
LOGIN_MAX_BACKOFF_SECONDS=8

# JWT (min 32 characters for JWT_SECRET)
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_ISSUER=EnterpriseLogger
JWT_AUDIENCE=EnterpriseLogger.Api
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_MAX_SESSION_HOURS=8

# Comma-separated origins for tenant panel (Vite default: http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173
