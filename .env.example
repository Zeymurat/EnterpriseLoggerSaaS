# Copy this file to .env in the project root and fill in your local values.
# .env is gitignored — never commit real passwords.

POSTGRES_USER=postgres_db_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=EnterpriseLoggerDb

DB_CONNECTION_STRING=Host=db_host;Port=5432;Database=DatabaseName;Username=postgres_db_user;Password=your_secure_password_here
REDIS_CONNECTION_STRING=redis_host:6379
