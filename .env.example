# Copy this file to .env in the project root and fill in your local values.
# .env is gitignored — never commit real passwords.
#
# Quick start (full stack):
#   cp .env.example .env
#   # Edit POSTGRES_PASSWORD, JWT_SECRET, PLATFORM_ADMIN_* 
#   docker compose up -d --build
#
# Open: Tenant panel http://localhost:5173 | Platform admin http://localhost:5174 | API http://localhost:5247

POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=EnterpriseLoggerDb

# Used by local dotnet run (host machine). Docker Compose overrides these for the API container.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=EnterpriseLoggerDb;Username=saas_admin;Password=your_secure_password_here
REDIS_CONNECTION_STRING=localhost:6379

# Database migrations run automatically on API startup in Development / Docker (RUN_DATABASE_MIGRATIONS=true).
# Manual update when needed:
#   dotnet ef database update --project EnterpriseLogger.Infrastructure --startup-project EnterpriseLogger.Api

# Log ingestion limits come from the active package (MaxLogsPerMinute / MonthlyRequestLimit).

# Public endpoint rate limits (IP-scoped)
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TENANT_REGISTER_RATE_LIMIT_PER_MINUTE=5
TENANT_REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxy: set true only behind trusted Nginx/load balancer
TRUST_FORWARDED_HEADERS=false

# Login lockout & backoff (email + IP counters in Redis)
LOGIN_MAX_FAILED_ATTEMPTS_EMAIL=10
LOGIN_MAX_FAILED_ATTEMPTS_IP=30
LOGIN_LOCKOUT_MINUTES=15
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_BACKOFF_START_AFTER=3
LOGIN_MAX_BACKOFF_SECONDS=8

# JWT (min 32 characters for JWT_SECRET)
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_ISSUER=EnterpriseLogger
JWT_AUDUENCE=EnterpriseLogger.Api
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_MAX_SESSION_HOURS=8

# Comma-separated origins for frontends (must match Docker host ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Tenant panel base URL (login-as redirect target)
TENANT_PANEL_URL=http://localhost:5173

# Platform admin bootstrap (seeded on first API startup when table is empty)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change_me_min_12_chars

# Subscription renewal: grace period (days) after auto-renew before downgrade to Free
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7

# E-mail notifications (optional — requires SMTP; package must have IsMailEnabled)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=EnterpriseLogger
SMTP_USE_SSL=true
